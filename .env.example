# ==========================================
# AI 对话平台 - 环境变量配置模板
# ==========================================
# 复制此文件为 .env 并填写实际值
# 不要提交包含真实密钥的 .env 文件

# ==========================================
# 应用基础配置
# ==========================================
NODE_ENV=production
PORT=8081

# 前端统一走同源 /api，由 Next.js 代理到后端
NEXT_PUBLIC_API_URL=/api
BACKEND_INTERNAL_URL=http://localhost:8081

# ==========================================
# 数据库配置（可选，如使用）
# ==========================================
# PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/chatdb

# Redis（用于会话存储/缓存）
# REDIS_URL=redis://localhost:6379

# ==========================================
# LLM API 配置
# ==========================================
# OpenAI
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Azure OpenAI
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=gpt-4

# One API / APIPark 聚合平台
# ONE_API_URL=http://localhost:3000
# ONE_API_KEY=your-one-api-key

# DeepSeek
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 智谱AI
# ZHIPU_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==========================================
# 认证配置（可选）
# ==========================================
# JWT 密钥
# JWT_SECRET=your-super-secret-jwt-key-change-in-production

# 会话密钥
# SESSION_SECRET=your-session-secret-change-in-production

# ==========================================
# 日志与监控
# ==========================================
LOG_LEVEL=info

# ==========================================
# 安全配置
# ==========================================
# CORS 允许的 origins（逗号分隔）
CORS_ORIGIN=http://localhost:5173,http://localhost:8081

# ==========================================
# 部署配置
# ==========================================
# 健康检查路径
HEALTH_CHECK_PATH=/health

# 请求超时（毫秒）
REQUEST_TIMEOUT=60000
