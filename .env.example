# =====================================================
#  AI Chat Backend - 环境变量模板
#  复制此文件为 .env 并填写真实值
#  警告: 切勿提交 .env 到 Git (.gitignore 已排除)
# =====================================================

# ==================
#  应用基础配置
# ==================
# 运行环境: development | test | production
NODE_ENV=development

# 后端服务端口
PORT=30000

# 前端 Next.js 公开 API 路径（同源代理，无需填写完整 URL）
NEXT_PUBLIC_API_URL=/api
# Docker 内部后端地址
BACKEND_INTERNAL_URL=http://backend:30000

# ==================
#  日志与监控
# ==================
# 日志级别: debug | info | warn | error
LOG_LEVEL=info

# 健康检查端点路径
HEALTH_CHECK_PATH=/api/health

# 请求超时 (ms)
REQUEST_TIMEOUT=60000

# ==================
#  安全配置
# ==================
# CORS 允许的 origins (逗号分隔)，生产环境必填
CORS_ORIGIN=http://localhost:3001,http://localhost:8080

# ==================
#  MiniMax Token Plan API (主要 LLM 提供商)
# ==================
# 在 https://api.minimaxi.com 获取
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic

# 默认模型 (M2.7 旗舰编程版)
MINIMAX_DEFAULT_MODEL=MiniMax-M2.7

# ==================
#  RAG 配置
# ==================
# 文档分块大小 (tokens)
RAG_CHUNK_SIZE=512
# 检索 Top-K
RAG_TOP_K=5
# 是否启用重排序
RAG_RERANK=true

# ==================
#  向量数据库
# ==================
# 类型: memory (默认, 内存) | qdrant (生产)
VECTOR_DB_TYPE=memory

# --- Qdrant (可选) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=chat_documents
QDRANT_DIMENSION=1024
# QDRANT_API_KEY=  # 留空表示无认证

# HNSW 索引参数
QDRANT_HNSW_M=32
QDRANT_HNSW_EF_CONSTRUCTION=128
QDRANT_HNSW_FULL_SCAN=10000

# PQ 量化
QDRANT_QUANTIZATION_ENABLED=true
QDRANT_QUANTILE=0.99

# ==================
#  PostgreSQL 数据库 (可选)
# ==================
# 格式: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://chat:chat_password@localhost:5432/aichat

# ==================
#  Redis 缓存 (可选)
# ==================
# 格式: redis://[:PASSWORD@]HOST:PORT[/DB]
REDIS_URL=redis://localhost:16389

# ==================
#  Agent 引擎配置
# ==================
# 最大迭代次数
AGENT_MAX_ITERATIONS=10
# 工具执行超时 (ms)
AGENT_TOOL_TIMEOUT=30000
# 是否启用 HITL 人工确认
AGENT_ENABLE_HITL=true

# ==================
#  速率限制
# ==================
# 全局限流 (请求/分钟/IP)
RATE_LIMIT_PER_MINUTE=100
# AI 端点限流
AI_RATE_LIMIT_PER_MINUTE=20
