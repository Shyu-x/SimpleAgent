# ==========================================
# AI 对话平台 - Docker 环境变量配置
# ==========================================

# ==========================================
# 应用基础配置
# ==========================================
NODE_ENV=production
PORT=30000

# 前端统一走同源 /api，由 Next.js 代理到后端
NEXT_PUBLIC_API_URL=/api
BACKEND_INTERNAL_URL=http://backend:30000

# ==========================================
# 日志与监控
# ==========================================
LOG_LEVEL=info

# ==========================================
# 安全配置
# ==========================================
# CORS 允许的 origins（逗号分隔）
CORS_ORIGIN=http://localhost:8080,http://frontend:8080

# ==========================================
# MiniMax Token Plan API (主要模型提供商)
# ==========================================
MINIMAX_API_KEY=your_minimax_token_plan_api_key
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic

# ==========================================
# Qdrant 向量数据库
# ==========================================
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=chat_documents
QDRANT_DIMENSION=1024

# ==========================================
# RAG 配置
# ==========================================
RAG_CHUNK_SIZE=512
RAG_TOP_K=5
RAG_RERANK=true

# ==========================================
# 部署配置
# ==========================================
HEALTH_CHECK_PATH=/api/health
REQUEST_TIMEOUT=60000