# ==========================================
# AI 对话平台 - 环境变量配置模板
# ==========================================
# 复制此文件为 .env 并填写实际值
# 不要提交包含真实密钥的 .env 文件

# ==========================================
# 应用基础配置
# ==========================================
NODE_ENV=production
PORT=8081

# 前端统一走同源 /api，由 Next.js 代理到后端
NEXT_PUBLIC_API_URL=/api
BACKEND_INTERNAL_URL=http://localhost:8081

# ==========================================
# 日志与监控
# ==========================================
LOG_LEVEL=info

# ==========================================
# 安全配置
# ==========================================
# CORS 允许的 origins（逗号分隔）
CORS_ORIGIN=http://localhost:5173,http://localhost:8081

# ==========================================
# MiniMax Token Plan API (主要模型提供商)
# ==========================================
MINIMAX_API_KEY=sk-cp-your_token_plan_api_key
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic

# ==========================================
# Qdrant 向量数据库
# ==========================================
# 向量存储模式：qdrant（默认），memory（降级备用）
VECTOR_DB_TYPE=qdrant

# Qdrant 连接配置
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=chat_documents
QDRANT_DIMENSION=1024

# Qdrant HNSW 索引配置
QDRANT_HNSW_M=32
QDRANT_HNSW_EF_CONSTRUCTION=128
QDRANT_HNSW_FULL_SCAN=10000
QDRANT_HNSW_ON_DISK=false

# Qdrant PQ 量化配置
QDRANT_QUANTIZATION_ENABLED=true
QDRANT_QUANTILE=0.99
QDRANT_COMPRESSION=compression16

# Qdrant 连接池配置
QDRANT_POOL_MAX=50
QDRANT_POOL_TIMEOUT=30000
QDRANT_RETRY_ATTEMPTS=3
QDRANT_RETRY_DELAY=1000

# ==========================================
# RAG 配置
# ==========================================
# 文档分块大小
RAG_CHUNK_SIZE=512

# 检索返回数量
RAG_TOP_K=5

# 是否启用重排序
RAG_RERANK=true

# ==========================================
# 部署配置
# ==========================================
# 健康检查路径
HEALTH_CHECK_PATH=/health

# 请求超时（毫秒）
REQUEST_TIMEOUT=60000
