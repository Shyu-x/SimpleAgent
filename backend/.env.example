# AI Chat Backend Environment Configuration
# Copy this file to .env and fill in your API keys

# MiniMax API (default provider)
MINIMAX_API_KEY=your_minimax_api_key_here

# OpenAI API (optional)
OPENAI_API_KEY=

# Anthropic Claude API (optional)
CLAUDE_API_KEY=

# Zhipu AI API (optional)
ZHIPU_API_KEY=

# DeepSeek API (optional)
DEEPSEEK_API_KEY=

# Server Port
PORT=8080