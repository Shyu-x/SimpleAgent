#!/bin/sh
#
# Commit Msg Hook - 验证提交信息格式
#

# 检查是否为空
commit_msg=$(cat "$1")
if [ -z "$commit_msg" ]; then
  echo "✖ 提交信息不能为空"
  exit 1
fi

# 跳过 merge 提交
if echo "$commit_msg" | grep -qE "^Merge"; then
  exit 0
fi

# 运行 commitlint
echo "$commit_msg" | npx --yes commitlint --edit "$1" 2>/dev/null || exit 1
echo "✓ 提交信息格式验证通过"
