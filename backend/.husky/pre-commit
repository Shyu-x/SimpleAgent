#!/bin/sh
#
# Pre-Commit Hook - 提交前检查
#
# 检查内容：
# 1. 代码格式检查 (ESLint/Prettier)
# 2. 敏感信息检测
# 3. 重大文件检查
#

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo "🔍 开始 pre-commit 检查..."
echo ""

# 获取 git 根目录
git_dir=$(git rev-parse --git-dir 2>/dev/null)
project_root=$(git rev-parse --show-toplevel 2>/dev/null)

# 切换到项目根目录
cd "$project_root" || exit 1

# ========== 第一步：检测暂存的文件 ==========
echo "📦 检测暂存的文件..."
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    echo -e "${YELLOW}⚠️  没有暂存的文件，跳过检查${NC}"
    exit 0
fi

echo -e "${GREEN}✓ 发现 $(echo "$STAGED_FILES" | wc -l) 个暂存文件${NC}"
echo ""

# ========== 第二步：敏感信息检测 ==========
echo "🔒 检查敏感信息..."

SENSITIVE_PATTERNS="(
    # API 密钥和密码
    'api[_-]?key\s*=\s*["\''][a-zA-Z0-9]{20,}["\'']'
    'secret[_-]?key\s*=\s*["\''][a-zA-Z0-9]{20,}["\'']'
    'password\s*=\s*["\''][^"\'']{8,}["\'']'
    'token\s*=\s*["\''][a-zA-Z0-9]{20,}["\'']'

    # AWS 凭证
    'AKIA[0-9A-Z]{16}'
    'aws[_-]?access[_-]?key'
    'aws[_-]?secret'

    # 私钥
    '-----BEGIN (RSA |DSA |EC |OPENSSH )PRIVATE KEY-----'

    # 连接字符串中的密码
    'mongodb://[^:]+:[^@]+@'
    'postgres://[^:]+:[^@]+@'
    'mysql://[^:]+:[^@]+@'

    # 日志中的敏感信息
    '\"password\"\s*:\s*\"'
    '\"token\"\s*:\s*\"[a-zA-Z0-9]{20,}'
    '\"api_key\"\s*:\s*\"'
    '\"secret\"\s*:\s*\"'

    # 硬编码的密钥
    'encryption[_-]?key\s*='
    'jwt[_-]?secret\s*='
    'session[_-]?secret\s*='
)"

# 敏感文件检查
SENSITIVE_FILES="(
    .env
    .env.local
    .env.production
    *.pem
    *.key
    id_rsa*
    credential*
    *secret*
    *password*
    config.ini
)"

FOUND_SENSITIVE=0

for file in $STAGED_FILES; do
    # 检查是否是敏感文件
    filename=$(basename "$file")

    # 跳过 node_modules 和依赖目录
    if [[ "$file" == node_modules* ]] || [[ "$file" == *node_modules* ]]; then
        continue
    fi

    # 检查文件内容中的敏感信息
    if [ -f "$file" ]; then
        # 检查常见敏感模式
        while IFS= read -r pattern; do
            if grep -E "$pattern" "$file" &>/dev/null; then
                echo -e "${RED}✖ 发现敏感信息: $file${NC}"
                echo "  匹配模式: $pattern"
                FOUND_SENSITIVE=1
            fi
        done < <(echo "$SENSITIVE_PATTERNS" | tr '\n' ' ')

        # 检查是否在敏感文件列表中
        for sensitive in $(echo "$SENSITIVE_FILES"); do
            if [[ "$filename" == $sensitive ]]; then
                echo -e "${RED}✖ 敏感文件被提交: $file${NC}"
                FOUND_SENSITIVE=1
            fi
        done
    fi
done

if [ $FOUND_SENSITIVE -eq 1 ]; then
    echo ""
    echo -e "${RED}✖ 提交被阻止：发现敏感信息${NC}"
    echo "请移除敏感信息后再提交。"
    echo "提示：使用 .gitignore 排除敏感文件，使用环境变量管理密钥。"
    exit 1
fi

echo -e "${GREEN}✓ 无敏感信息${NC}"
echo ""

# ========== 第三步：检查 package.json 依赖 ==========
echo "📦 检查依赖文件变更..."

if echo "$STAGED_FILES" | grep -qE "(package\.json|package-lock\.json|yarn\.lock|pnpm-lock\.yaml)"; then
    echo -e "${BLUE}ℹ 检测到依赖文件变更${NC}"

    # 运行 npm audit
    if command -v npm &>/dev/null; then
        echo "🔍 运行 npm audit..."
        npm audit --audit-level=high 2>/dev/null || true
    fi
fi

# ========== 第四步：TypeScript 类型检查 ==========
echo "📝 检查 TypeScript 类型..."

if echo "$STAGED_FILES" | grep -qE "\.tsx?$"; then
    if [ -f "tsconfig.json" ]; then
        if command -v npx &>/dev/null; then
            echo "运行 TypeScript 类型检查..."
            npx tsc --noEmit --skipLibCheck 2>/dev/null

            if [ $? -ne 0 ]; then
                echo ""
                echo -e "${YELLOW}⚠️  TypeScript 类型检查失败${NC}"
                echo "建议：运行 'npm run type-check' 查看详细错误"
                echo "继续提交请使用 --no-verify"
            fi
        fi
    fi
fi

# ========== 第五步：ESLint 检查 ==========
echo "🔧 检查代码格式..."

if echo "$STAGED_FILES" | grep -qE "\.(js|jsx|ts|tsx)$"; then
    if [ -f ".eslintrc.js" ] || [ -f ".eslintrc.json" ]; then
        if command -v npx &>/dev/null; then
            echo "运行 ESLint..."

            # 只检查暂存的文件
            ESLINT_FILES=$(echo "$STAGED_FILES" | grep -E "\.(js|jsx|ts|tsx)$" | tr '\n' ' ')

            if [ -n "$ESLINT_FILES" ]; then
                npx eslint $ESLINT_FILES --max-warnings=0 2>/dev/null

                if [ $? -ne 0 ]; then
                    echo ""
                    echo -e "${YELLOW}⚠️  ESLint 检查失败${NC}"
                    echo "建议：运行 'npm run lint:fix' 自动修复"
                    echo "继续提交请使用 --no-verify"
                fi
            fi
        fi
    fi
fi

# ========== 第六步：Prettier 检查 ==========
echo "✨ 检查代码风格..."

if echo "$STAGED_FILES" | grep -qE "\.(js|jsx|ts|tsx|css|scss|json|md)$"; then
    if [ -f ".prettierrc" ] || [ -f ".prettierrc.json" ]; then
        if command -v npx &>/dev/null; then
            echo "运行 Prettier..."

            PRETTIER_FILES=$(echo "$STAGED_FILES" | grep -E "\.(js|jsx|ts|tsx|css|scss|json|md)$" | tr '\n' ' ')

            if [ -n "$PRETTIER_FILES" ]; then
                npx prettier --check $PRETTIER_FILES 2>/dev/null

                if [ $? -ne 0 ]; then
                    echo ""
                    echo -e "${YELLOW}⚠️  代码风格不符合 Prettier 规范${NC}"
                    echo "建议：运行 'npm run format' 自动格式化"
                    echo "继续提交请使用 --no-verify"
                fi
            fi
        fi
    fi
fi

# ========== 完成 ==========
echo ""
echo -e "${GREEN}✓ Pre-commit 检查完成${NC}"
echo ""
echo "提示："
echo "  - 使用 'npm run lint:fix' 自动修复格式问题"
echo "  - 使用 'npm run format' 格式化代码"
echo "  - 跳过检查使用 'git commit --no-verify'"
echo ""