{
  "comment": "Git hooks 配置 - husky",
  "npm": {
    "scripts": {
      "prepare": "husky install",
      "precommit": "lint-staged",
      "commit": "git-cz",
      "lint:staged": "lint-staged"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "commitizen": "^4.3.0"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "**/*.{css,scss}": [
      "prettier --write"
    ],
    "**/*.{json,md}": [
      "prettier --write"
    ],
    "**/package.json": [
      "sort-package-json"
    ],
    "**/*.{png,jpg,jpeg,gif,svg}": [
      "imagemin-lint-staged"
    ],
    "**/*.{php,py,rb,go}": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog",
      "maxLineWidth": 100,
      "defaultType": "feat",
      "defaultScope": "core"
    }
  }
}