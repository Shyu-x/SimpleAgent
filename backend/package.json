{
  "name": "@simpleagent/backend",
  "version": "2.5.0",
  "description": "SimpleAgent - 现代化AI对话平台后端服务",
  "engines": {
    "node": ">=18.0.0 <25.0.0",
    "pnpm": ">=8.0.0"
  },
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "jest",
    "test:api": "node tests/api-check.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prepare": "node scripts/install-hooks.js",
    "lint:staged": "lint-staged"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "**/*.{css,scss}": [
      "prettier --write"
    ],
    "**/*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "@prisma/client": "^7.5.0",
    "axios": "^1.6.0",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "ioredis": "^5.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "opossum": "^5.0.1",
    "pg": "^8.20.0",
    "playwright": "^1.40.0",
    "rate-limiter-flexible": "^11.1.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "tiktoken": "^1.0.22",
    "uuid": "^9.0.1",
    "vm2": "^3.10.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "autocannon": "^8.0.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "lint-staged": "^15.0.0",
    "loadtest": "^8.2.1",
    "prisma": "^7.5.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6"
  }
}
