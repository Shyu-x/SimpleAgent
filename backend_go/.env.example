# AI Chat 玩具 - Go 版本环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ==================== 应用配置 ====================
APP_ENV=development
APP_NAME=ai-chat-backend
APP_HOST=0.0.0.0
APP_PORT=30000

# ==================== MiniMax API 配置 ====================
MINIMAX_API_KEY=your_token_plan_api_key_here
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_TIMEOUT=60

# ==================== 数据库配置 ====================
# Docker Compose 使用 DATABASE_URL
DATABASE_URL=postgres://gagent:password@postgres:5432/gagent?sslmode=disable

# 本地开发使用以下配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ai_chat
DB_SSL_MODE=disable
DB_MAX_CONNECTIONS=20

# ==================== Redis 配置 ====================
# Docker Compose 使用 REDIS_URL
REDIS_URL=redis://redis:6379/0

# 本地开发使用以下配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10

# ==================== RAG 配置 ====================
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5
RAG_RERANK=true
RAG_RERANK_TOP_K=10

# ==================== Agent 配置 ====================
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT=120

# ==================== 日志配置 ====================
LOG_LEVEL=info
LOG_FORMAT=json

# ==================== 限流器配置 ====================
RATE_LIMITER_ENABLED=true
RATE_LIMITER_CAPACITY=100
RATE_LIMITER_REFILL_RATE=50

# ==================== 熔断器配置 ====================
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2
CIRCUIT_BREAKER_TIMEOUT=60

# ==================== CORS 配置 ====================
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
