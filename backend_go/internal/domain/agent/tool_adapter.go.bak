/**
 * 工具执行器适配器
 * 将 ToolRegistry 适配为 ToolExecutor 接口
 */

package agent

import (
	"context"
	"fmt"

	"github.com/ai-chat/backend_go/internal/domain/model"
	"github.com/ai-chat/backend_go/internal/services/tools"
)

// ToolExecutorAdapter 工具执行器适配器 - 适配 ToolRegistry 到 ToolExecutor 接口
type ToolExecutorAdapter struct {
	registry *tools.ToolRegistry
}

// NewToolExecutorAdapter 创建工具执行器适配器
func NewToolExecutorAdapter(registry *tools.ToolRegistry) *ToolExecutorAdapter {
	return &ToolExecutorAdapter{
		registry: registry,
	}
}

// Execute 执行工具
func (a *ToolExecutorAdapter) Execute(ctx context.Context, toolName string, args map[string]interface{}) (*ToolResult, error) {
	result, err := a.registry.Execute(ctx, toolName, args)
	if err != nil {
		return nil, err
	}

	return &ToolResult{
		ToolName: result.ToolName,
		Args:     result.Args,
		Result:   result.Result,
		Error:    result.Error,
		Duration: result.Duration,
	}, nil
}

// Register 注册工具
func (a *ToolExecutorAdapter) Register(definition model.ToolDefinition, handler func(ctx context.Context, args map[string]interface{}) (interface{}, error) {
	a.registry.Register(definition, handler)
}

// ListTools 列出所有工具
func (a *ToolExecutorAdapter) ListTools() []model.ToolDefinition {
	tools := a.registry.ListTools()
	result := make([]model.ToolDefinition, len(tools))
	for i, t := range tools {
		result[i] = model.ToolDefinition{
			Name:        t.Name,
			Description: t.Description,
			Parameters:  t.Parameters,
		}
	}
	return result
}

// DefaultToolExecutorAdapter 默认工具执行器适配器
type DefaultToolExecutorAdapter struct {
	registry *ToolRegistry
}

// NewDefaultToolExecutorAdapter 创建默认工具执行器适配器
func NewDefaultToolExecutorAdapter(registry *ToolRegistry) *DefaultToolExecutorAdapter {
	return &DefaultToolExecutorAdapter{
		registry: registry,
	}
}

// Execute 执行工具
func (a *DefaultToolExecutorAdapter) Execute(ctx context.Context, toolName string, args map[string]interface{}) (*ToolResult, error) {
	spec, ok := a.registry.Get(toolName)
	if !ok {
		return nil, fmt.Errorf("tool not found: %s", toolName)
	}

	result, err := spec.Handler(ctx, args)
	if err != nil {
		return &ToolResult{
			ToolName: toolName,
			Args:     args,
			Result:   nil,
			Error:    err,
		}, err
	}

	return &ToolResult{
		ToolName: toolName,
		Args:     args,
		Result:   result,
		Error:    nil,
	}, nil
}

// Register 注册工具
func (a *DefaultToolExecutorAdapter) Register(definition model.ToolDefinition, handler func(ctx context.Context, args map[string]interface{}) (interface{}, error) {
	a.registry.Register(definition.Name, ToolSpec{
		Definition: definition,
		Handler:    handler,
	})
}

// ListTools 列出所有工具
func (a *DefaultToolExecutorAdapter) ListTools() []model.ToolDefinition {
	return a.registry.List()
}
