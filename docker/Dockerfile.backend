# ============================================
# SimpleAgent Backend - 多阶段 Dockerfile
# 目标: < 200MB 镜像
# ============================================

# --- Stage 1: deps 准备 (利用 pnpm 缓存) ---
FROM node:20-alpine AS deps

# 国内/国外 mirror 自适应 (Alpine 内置 corepack 自带 pnpm, 无需 npm install -g)
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

WORKDIR /app

# 只拷贝 lockfile 和 package.json 优先利用缓存
COPY backend/package.json backend/pnpm-lock.yaml* ./
RUN pnpm fetch --frozen-lockfile

# 离线安装生产依赖
RUN pnpm install --frozen-lockfile --offline --ignore-scripts --prod

# --- Stage 2: runtime ---
FROM node:20-alpine AS runtime

# 健康检查工具
RUN apk add --no-cache wget tini

ENV NODE_ENV=production \
    PORT=30000 \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NODE_OPTIONS="--max-old-space-size=512"

# 非 root 用户
RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001

WORKDIR /app

# WORKDIR 归 nodejs 用户所有 (允许 nodejs 写入 logs/ 等运行时目录)
RUN chown nodejs:nodejs /app

# 只拷贝生产 node_modules (来自 deps stage)
COPY --from=deps --chown=nodejs:nodejs /app/node_modules ./node_modules
COPY --from=deps --chown=nodejs:nodejs /app/package.json ./package.json
COPY --chown=nodejs:nodejs backend/src ./src

USER nodejs

EXPOSE 30000

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:30000/api/health || exit 1

# tini 正确处理 PID 1 信号
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "src/index.js"]
