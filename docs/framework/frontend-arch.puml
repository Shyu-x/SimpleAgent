skinparam rectangleDesktop {
  BackgroundColor #f3e5f5
  BorderColor #7b1fa2
}

title 主页面布局结构 (app/page.tsx)

' 响应式判断
if (isMobile) then (yes)
  rectangle MobileLayout [MobileLayout\n移动端布局] {
    rectangle BottomNavigation [Bottom Navigation\n底部导航栏]
    rectangle MobileChatArea [MobileChatArea\n自适应聊天区域]
    rectangle BottomSheet [BottomSheet\n底部弹出面板\n(设置/历史)]
  }
  MobileLayout --> ToastProvider
else (no)
  rectangle DesktopShell [Desktop Shell\n桌面端容器] {
    rectangle BackgroundEffects [Background Effects\n渐变模糊装饰]

    rectangle LeftSidebar [左侧边栏\n(动画: AnimatePresence)] {
      rectangle ConversationList [ConversationList\n对话列表]
    }

    rectangle MainContent [主内容区] {
      rectangle Header [Header\n顶部导航栏] {
        rectangle MenuButton [菜单按钮\n(打开侧边栏)]
        rectangle ConversationInfo [对话信息\n标题+更新时间]
        rectangle LayoutSwitcher [布局切换器\n单/水平/垂直/网格]
        rectangle PanelTabs [功能面板标签\n设置/记忆/智能体/工具/知识库]
      }

      rectangle ChatContainer [聊天容器] {
        rectangle MultiWindowChat [MultiWindowChat\n多窗口布局]
      }
    }

    rectangle RightPanel [右侧弹出面板\n(Modal)] {
      rectangle SettingsPanel [Settings\nAPI设置]
      rectangle MemoryPanel [MemoryPanel\n记忆管理]
      rectangle AgentsPanel [MultiAgentPanel\n多Agent]
      rectangle ToolsPanel [ToolMarketplace\n工具市场]
      rectangle KnowledgeBase [KnowledgeBaseManager\n知识库]
    }
  }

  BackgroundEffects -[hidden]-> LeftSidebar
  LeftSidebar -[hidden]-> MainContent
  MainContent -[hidden]-> RightPanel
endif

' 全局浮层
rectangle GlobalOverlays [全局浮层] {
  rectangle KeyboardShortcuts [KeyboardShortcuts\n键盘快捷键]
  rectangle PromptSelector [PromptSelector\n提示词选择器]
  rectangle WelcomeGuide [WelcomeGuide\n欢迎向导]
}

ToastProvider --> (isMobile ? MobileLayout : DesktopShell)
(isMobile ? MobileLayout : DesktopShell) --> GlobalOverlays

