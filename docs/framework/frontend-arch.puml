@startuml 页面结构图
!layout strict

skinparam page {
  BackgroundColor white
}
skinparam rectangle {
  BackgroundColor #f8f9fa
  BorderColor #333
}
skinparam rectangleMobile {
  BackgroundColor #e3f2fd
  BorderColor #1976d2
