@startuml 状态管理图 - Zustand ChatStore
!layout strict

skinparam interface {
  BackgroundColor #fff3e0
  BorderColor #ef6c00
}
skinparam class {
  BackgroundColor #e8f5e9
  BorderColor #2e7d32
}
skinparam rectangle {
  BackgroundColor #e3f2fd
  BorderColor #1976d2
}

title Zustand 状态管理架构 - ChatStore

interface State [State\n状态数据] {
  conversations: Conversation[]\n--\n
  globalMemories: GlobalMemory[]\n--\n
  customPrompts: PromptTemplate[]\n--\n
  activeConversationId: string | null\n--\n
  activeConversationIds: string[]\n(多窗口支持)\n--\n
  apiConfig: APIConfig\n--\n
  configuredModels: ConfiguredModel[]\n--\n
  settings: Settings\n{theme, palette, typingSpeed, fontSize, windowLayout}\n--\n
  showWelcomeGuide: boolean\n--\n
  hasHydrated: boolean
}

interface Actions [Actions\n方法] {
  对话管理:\n
  createConversation()\n
  deleteConversation()\n
  restoreConversation()\n
  setActiveConversation()\n
  reorderConversations()\n
  updateConversationTitle()\n--\n
  多窗口:\n
  addActiveWindow()\n
  removeActiveWindow()\n--\n
  消息管理:\n
  addMessage()\n
  updateLastMessage()\n
  deleteMessage()\n
  updateMessageContent()\n
  finalizeMessage()\n--\n
  笔记/记忆:\n
  addNote()\n
  updateNote()\n
  deleteNote()\n
  addGlobalMemory()\n
  updateGlobalMemory()\n
  deleteGlobalMemory()\n--\n
  配置:\n
  setApiConfig()\n
  addConfiguredModel()\n
  removeConfiguredModel()\n
  setSettings()\n--\n
  提示词:\n
  addCustomPrompt()\n
  updateCustomPrompt()\n
  deleteCustomPrompt()\n--\n
  水合:\n
  rehydrate()\n
  setHasHydrated()
}

rectangle Persistence [持久化配置\nsessionStorage]\n{
  name: "ai-chat-storage"\n--\n
  partialize 过滤:\n
  \u2713 持久化 conversations\n
  \u2713 持久化 globalMemories\n
  \u2713 持久化 customPrompts\n
  \u2713 持久化 settings\n
  \u2713 只持久化 model/baseURL (不保存apiKey)\n
  \u2713 configuredModels 清空apiKey再存储\n--\n
  安全特性:\n
  - API Key 不持久化\n
  - sessionStorage 关闭即清除\n
  - skipHydration 防止SSR不匹配
}

class useChatStore [useChatStore\ncreate&lt;ChatState&gt;()]

State --> useChatStore
Actions --> useChatStore
useChatStore --> Persistence

note top of Persistence
  🔒 安全设计: API Key 不在前端持久化
  即使XSS攻击，API Key也只存在于内存
  关闭标签页自动清除所有数据
end note

@enduml

@startuml API调用流程图 - SSE流式响应
!layout strict

skinparam activity {
  BackgroundColor #f5f5f5
  BorderColor #424242
}
skinparam arrow {
  Color #1976d2
}

title SSE 流式API调用流程

start

:用户输入消息\n(可选: 图片/语音附件);

:ChatArea.handleSendMessage();

:创建 userMessage\n加入 conversation;

:创建空 assistantMessage\n加入 conversation;

:组装 messages 历史数组;

:sendSSEChatMessage()\n调用后端代理;

:POST /api/v1/chat/completions\nBody: {model, messages, apiKey, baseURL, provider}\n带 AbortSignal;

:后端代理转发到对应厂商API\nOpenAI/Anthropic/MiniMax/...;

:获取 Response.body 可读流;

:创建 Reader + TextDecoder;

while (done != true)
  :reader.read();
  :buffer += decoder.decode(value);
  :按行分割 buffer，弹出不完整行;

  for each (line in lines)
    if (line starts with "data:") then (yes)
      :data = JSON.parse(line.slice(5));

      if (data.type == "error") then (yes)
        :调用 onError(error);
        stop
      else if (data == "[DONE]" || data.type == "done") then (yes)
        break
      else (content exists)
        :提取 content = json.choices[0].delta.content;
        :onMessage(content) -> updateLastMessage();
        ' 增量更新 Zustand 状态
      endif
    endif
  end for
end while

:onComplete() -> finalizeMessage();\n标记消息已完成;

:设置 isLoading = false;

stop

note over 前端,后端
  安全架构: API Key 由后端代理转发
  前端不直接调用厂商API，避免API Key泄露
end note

@enduml

