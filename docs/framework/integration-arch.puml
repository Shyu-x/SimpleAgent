@startuml rag-architecture
!theme plain
skinparam backgroundColor #FEFEFE
skinparam componentStyle rectangle

title RAG 知识库架构图

' ============================================
' 第四部分：RAG 知识库架构（组件图）
' ============================================

package "文档处理" {
    [文档上传] as Upload
    [文件解析器] as Parser
    [文本分块器\nchunkText()] as Chunker

    package "支持格式" {
        [TXT/MD] as Text
        [JSON] as JSON
        [PDF] as PDF
        [DOC/DOCX] as Doc
    }
}

package "向量化" {
    [嵌入生成器] as Embedder

    package "嵌入策略" {
        [OpenAI\ntext-embedding-ada-002\n优先] as OpenAIEmbed
        [本地嵌入\nTF-IDF 简化实现\n降级] as LocalEmbed
    }
}

package "知识库存储" {
    [RAG Service] as RAGService
    [知识库管理器] as KBManager

    package "存储结构" {
        [知识库 KB] as KB
        [文档 Document] as Doc
        [分块 Chunk] as Chunk
        [嵌入向量 Embedding] as Embed
    }
}

package "检索系统" {
    [相似度计算\ncosineSimilarity()] as Similarity
    [混合检索\nHybridSearch] as HybridSearch

    package "检索通道" {
        [向量检索\nVector] as Vector
        [全文检索\nFullText] as FullText
        [意图检索\nIntent] as Intent
    }

    [重排序\nReranker] as Reranker
}

package "上下文注入" {
    [上下文构建器] as ContextBuilder
    [Prompt 注入] as PromptInject
}

package "文件存储" {
    database "本地文件系统\n./data/rag/" as Storage
}

' 连接关系

Upload --> Parser : 解析文件
Parser --> Text
Parser --> JSON
Parser --> PDF
Parser --> Doc

Parser --> Chunker : 分块
Chunker --> Embedder : 生成嵌入

Embedder --> OpenAIEmbed : API 调用
OpenAIEmbed ..> LocalEmbed : 降级

Embedder --> RAGService : 存储向量

RAGService --> KBManager : 管理知识库
KBManager --> KB
KB --> Doc
Doc --> Chunk
Chunk --> Embed

RAGService --> Storage : 持久化

HybridSearch --> Vector : 语义相似
HybridSearch --> FullText : 关键词匹配
HybridSearch --> Intent : 意图匹配

Vector --> Similarity
FullText --> Similarity
Intent --> Similarity

HybridSearch --> Reranker : 结果合并

ContextBuilder --> RAGService : retrieve()
ContextBuilder --> PromptInject : 注入对话

note right of Chunker
  分块参数:
  - chunkSize: 500
  - overlap: 50
  按句子分割
end note

note right of Similarity
  余弦相似度:
  similarity = dot(A, B) / (||A|| * ||B||)

  阈值: 0.3
  TopK: 5
end note

note bottom of HybridSearch
  通道权重:
  - vector: 0.5
  - fulltext: 0.3
  - intent: 0.2
end note

@enduml

@startuml data-flow-overview
!theme plain
skinparam backgroundColor #FEFEFE
skinparam componentStyle rectangle

title 数据流总图

' ============================================
' 第五部分：数据流总图（部署图）
' ============================================

node "用户设备" {
    [浏览器] as Browser
}

node "前端服务器\nNext.js :3000" {
    [React 组件] as React
    [Zustand Store] as Store
    [SSE 客户端] as SSEClient
    [打字机渲染] as Typewriter
}

node "后端服务器\nExpress :30000" {
    [API 网关] as Gateway
    [路由中间件] as Middleware

    package "核心服务" {
        [模型路由器] as Router
        [意图分类器] as Intent
        [查询改写器] as QueryRewriter
        [混合检索] as HybridSearch
    }

    package "功能模块" {
        [RAG 服务] as RAG
        [MCP 服务] as MCP
        [Agent 引擎] as Agent
        [浏览器自动化] as BrowserAuto
    }

    [SSE 流处理] as SSEServer
}

node "数据存储" {
    database "知识库存储\n./data/rag/" as KBStorage
    folder "会话存储\nsessionStorage" as SessionStorage
}

node "外部服务" {
    cloud "OpenAI API" as OpenAI
    cloud "Anthropic API" as Anthropic
    cloud "MiniMax API" as MiniMax
    cloud "DeepSeek API" as DeepSeek
    cloud "智谱 AI API" as Zhipu
}

' 数据流连接

Browser --> React : 用户交互
React --> Store : 状态更新
Store --> SSEClient : 发送请求
SSEClient --> Gateway : HTTP/SSE

Gateway --> Middleware : 路由分发

Middleware --> Router : 聊天请求
Router --> Intent : 意图识别
Intent --> QueryRewriter : 查询优化
QueryRewriter --> HybridSearch : 检索

Middleware --> RAG : 知识查询
Middleware --> MCP : 工具调用
Middleware --> Agent : Agent 任务
Middleware --> BrowserAuto : 自动化

RAG --> KBStorage : 读写
MCP --> KBStorage : 读取

Router --> OpenAI : API 调用
Router --> Anthropic
Router --> MiniMax
Router --> DeepSeek
Router --> Zhipu

OpenAI --> SSEServer : 流式响应
Anthropic --> SSEServer
MiniMax --> SSEServer
DeepSeek --> SSEServer
Zhipu --> SSEServer

SSEServer --> SSEClient : SSE 流
SSEClient --> Typewriter : 解析
Typewriter --> React : 渲染

Store --> SessionStorage : 持久化

note right of Router
  流量分发:
  - 请求路由
  - 负载均衡
  - 熔断降级
  - 重试机制
end note

note left of SSEServer
  SSE 流格式:
  data: {"content": "..."}

  特点:
  - 实时推送
  - 打字机效果
  - 低延迟
end note

@enduml