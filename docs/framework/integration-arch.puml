@startuml integration-architecture
!theme plain
skinparam backgroundColor #FEFEFE
skinparam componentStyle rectangle

title AI Chat 玩具 - 系统集成架构图
caption 版本 1.0 | 生成日期: 2026-03-18

' ============================================
' 第一部分：端到端请求流程（序列图）
' ============================================

participant "用户浏览器" as User
participant "Next.js 前端\n:3000" as Frontend
participant "Express 后端\n:30000" as Backend
participant "ModelRouter\n路由器" as Router
participant "TaskClassifier\n意图分类器" as Classifier
participant "API 提供商\n(OpenAI/Anthropic/\nMiniMax/DeepSeek)" as Provider
participant "RAG 服务\n知识库" as RAG
participant "MCP 服务\n工具系统" as MCP

autonumber

== 用户发起请求 ==

User -> Frontend : 发送消息
activate Frontend

Frontend -> Frontend : 更新本地状态 (Zustand)
Frontend -> Backend : POST /api/chat\n{ messages, model, stream }

activate Backend

== 后端处理 ==

Backend -> Router : route(context)
activate Router

Router -> Classifier : classify(context)
activate Classifier

Classifier -> Classifier : 检测多模态内容\n匹配意图关键词\n计算置信度

Classifier --> Router : { intent, confidence,\ncomplexity, action }

Router -> Router : selectModel()\n根据策略选择模型\n- PERFORMANCE\n- COST\n- BALANCED

Router --> Backend : { model, classification }

Backend -> Backend : 构建请求体\n转换消息格式

== RAG 知识注入 ==

alt 需要知识检索
    Backend -> RAG : retrieve(kbId, query)
    activate RAG

    RAG -> RAG : generateEmbedding(query)
    RAG -> RAG : cosineSimilarity()\n计算相似度

    RAG --> Backend : { context, sources }

    Backend -> Backend : 注入知识上下文\nto messages
end

== 调用 AI 提供商 ==

Backend -> Provider : HTTP POST\n/api/chat/completions
activate Provider

Provider --> Backend : SSE 流式响应

Backend --> Frontend : SSE 流式转发
deactivate Provider

== MCP 工具调用（可选）==

opt 工具调用
    Backend -> MCP : handleToolCall(name, args)
    activate MCP

    MCP -> MCP : 执行工具\n- web_search\n- code_review\n- task_breakdown

    MCP --> Backend : { content, result }

    Backend -> Provider : 继续对话\n附带工具结果
    Provider --> Backend : 最终响应
end

== 返回响应 ==

Frontend -> Frontend : 解析 SSE 流\n打字机效果渲染
Frontend --> User : 显示 AI 响应

deactivate Frontend
deactivate Backend
deactivate Router
deactivate Classifier
deactivate RAG
deactivate MCP

@enduml

@startuml model-router-architecture
!theme plain
skinparam backgroundColor #FEFEFE
skinparam componentStyle rectangle

title 多模型路由架构图

' ============================================
' 第二部分：多模型路由架构（组件图）
' ============================================

package "前端层" {
    [用户界面] as UI
    [API 配置\napiConfig.ts] as APIConfig
    [状态管理\nZustand] as Store
}

package "路由层" {
    [ModelRouter] as Router
    [TaskClassifier] as Classifier
    [LLM Intent\nClassifier] as LLMClassifier

    package "路由策略" {
        [PERFORMANCE\n性能优先] as PerfStrategy
        [COST\n成本优先] as CostStrategy
        [BALANCED\n平衡模式] as BalancedStrategy
    }
}

package "模型池" {
    [ModelPool] as Pool
    [健康检查] as HealthCheck
    [负载均衡] as LoadBalancer
}

package "提供商适配器" {
    [OpenAI Adapter] as OpenAI
    [Anthropic Adapter] as Anthropic
    [MiniMax Adapter] as MiniMax
    [DeepSeek Adapter] as DeepSeek
    [智谱 AI Adapter] as Zhipu
}

package "外部 API" {
    cloud "OpenAI API\napi.openai.com" as OpenAIAPI
    cloud "Anthropic API\napi.anthropic.com" as AnthropicAPI
    cloud "MiniMax API\napi.minimaxi.com" as MiniMaxAPI
    cloud "DeepSeek API\napi.deepseek.com" as DeepSeekAPI
    cloud "智谱 API\nopen.bigmodel.cn" as ZhipuAPI
}

' 连接关系

UI --> APIConfig : 使用端点
UI --> Store : 状态同步
Store --> APIConfig : 获取配置

APIConfig --> Router : 路由请求

Router --> Classifier : 分类任务
Classifier --> LLMClassifier : LLM 分类\n(可选)
Classifier ..> PerfStrategy : 选择策略
Classifier ..> CostStrategy
Classifier ..> BalancedStrategy

Router --> Pool : 获取可用模型
Pool --> HealthCheck : 检查状态
Pool --> LoadBalancer : 负载分配

Router --> OpenAI : 适配请求
Router --> Anthropic
Router --> MiniMax
Router --> DeepSeek
Router --> Zhipu

OpenAI --> OpenAIAPI : HTTPS
Anthropic --> AnthropicAPI : HTTPS
MiniMax --> MiniMaxAPI : HTTPS
DeepSeek --> DeepSeekAPI : HTTPS
Zhipu --> ZhipuAPI : HTTPS

note right of Router
  选择逻辑:
  1. 任务分类
  2. 意图识别
  3. 复杂度评估
  4. 模型匹配
  5. 策略排序
  6. 负载均衡
end note

note bottom of Classifier
  意图类型:
  - TOOL_USE: 工具调用
  - CREATIVE: 创意生成
  - TASK: 任务执行
  - KNOWLEDGE: 知识查询
  - CONVERSATION: 日常对话
  - VISION: 视觉理解
end note

@enduml

