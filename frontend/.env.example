# ==========================================
# AI Chat 玩具 - 前端环境变量配置模板
# ==========================================
# 复制此文件为 .env.local 并填写实际值
# 不要提交包含真实信息的 .env.local 文件
# Next.js 会自动加载 .env.local 中的变量（优先级最高）

# ==========================================
# 开发环境配置
# ==========================================

# 开发服务器端口
NEXT_PORT=3001

# API 代理路径（Next.js rewrites 会将 /api/* 代理到后端）
NEXT_PUBLIC_API_URL=/api

# 后端服务地址（用于 API 客户端直接连接）
# 开发环境：localhost:30000
# 生产环境：通过 Nginx 反向代理时使用内部地址
NEXT_PUBLIC_BACKEND_URL=http://localhost:30000

# Next.js 内部使用的后端地址（与 NEXT_PUBLIC_BACKEND_URL 相同）
BACKEND_INTERNAL_URL=http://localhost:30000

# ==========================================
# 生产环境配置（通过 Nginx 部署时使用）
# ==========================================
# NEXT_PUBLIC_API_URL=/api
# NEXT_PUBLIC_BACKEND_URL=http://localhost:8088
# BACKEND_INTERNAL_URL=http://backend:30000

# ==========================================
# Node 环境
# ==========================================
NODE_ENV=development