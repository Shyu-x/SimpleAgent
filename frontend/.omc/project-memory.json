      "mf:user": "cd apps/module-user && npx webpack serve --config webpack.config.js",
      "mf:payment": "cd apps/module-payment && npx webpack serve --config webpack.config.js",
      "mf:build": "npm run mf:build:order && npm run mf:build:user && npm run mf:build:payment",
      "mf:build:order": "cd apps/module-order && npx webpack build",
      "mf:build:user": "cd apps/module-user && npx webpack build",
      "mf:build:payment": "cd apps/module-payment && npx webpack build"
