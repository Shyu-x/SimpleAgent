{
  "name": "@simpleagent/frontend",
  "version": "2.5.0",
  "private": true,
  "engines": {
    "node": ">=18.0.0 <25.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "dev:turbo": "next dev -p 3001",
    "dev:webpack": "next dev --webpack -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint .",
    "quick:check": "node test-quick-detect.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node ../tests/e2e/full-interface-test.js",
    "test:e2e:playwright": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:mobile": "playwright test --project=\"Mobile Chrome\"",
    "test:e2e:report": "playwright show-report",
    "test:build": "node tests/build-check.js",
    "test:e2e:check": "node tests/e2e-check.js",
    "mf:dev": "concurrently \"npm run dev\" \"npm run mf:order\" \"npm run mf:user\" \"npm run mf:payment\"",
    "mf:order": "cd apps/module-order && npx webpack serve --config webpack.config.js",
    "mf:user": "cd apps/module-user && npx webpack serve --config webpack.config.js",
    "mf:payment": "cd apps/module-payment && npx webpack serve --config webpack.config.js",
    "mf:build": "npm run mf:build:order && npm run mf:build:user && npm run mf:build:payment",
    "mf:build:order": "cd apps/module-order && npx webpack build",
    "mf:build:user": "cd apps/module-user && npx webpack build",
    "mf:build:payment": "cd apps/module-payment && npx webpack build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@module-federation/vite": "^1.15.4",
    "@sentry/react": "^10.53.1",
    "@types/katex": "^0.16.8",
    "dompurify": "^3.3.3",
    "framer-motion": "^12.36.0",
    "katex": "^0.16.38",
    "lucide-react": "^0.460.0",
    "next": "^16.2.6",
    "next-intl": "^4.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-markdown": "^9.0.1",
    "recharts": "^3.8.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "shiki": "^4.0.2",
    "zustand": "5.0.0"
  },
  "overrides": {
    "postcss": "^8.5.14"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@next/bundle-analyzer": "^16.2.6",
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.15",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.6",
    "autoprefixer": "^10.4.20",
    "babel-jest": "^30.4.1",
    "babel-loader": "^9.2.1",
    "concurrently": "^9.1.2",
    "css-loader": "^7.1.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.0.0",
    "html-webpack-plugin": "^5.6.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.58.2",
    "postcss": "^8.5.14",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0",
    "webpack": "^5.99.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0"
  }
}
